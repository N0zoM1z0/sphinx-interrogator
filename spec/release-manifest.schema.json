{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sphinx-interrogator.local/spec/release-manifest.schema.json",
  "title": "Sphinx Interrogator release manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "kind",
    "schema",
    "status",
    "started_at",
    "ended_at",
    "duration_ms",
    "repository",
    "versions",
    "command",
    "validation_commands",
    "release_checks",
    "artifacts",
    "hashes",
    "summary",
    "manifest_sha256"
  ],
  "properties": {
    "manifest_version": {
      "const": "2.0"
    },
    "kind": {
      "const": "sphinx-interrogator-release"
    },
    "schema": {
      "const": "release-manifest/v2"
    },
    "status": {
      "enum": [
        "complete",
        "blocked"
      ]
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "ended_at": {
      "$ref": "#/$defs/timestamp"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "head",
        "branch",
        "dirty",
        "status_short"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/git_revision"
        },
        "head": {
          "$ref": "#/$defs/git_revision"
        },
        "branch": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "status_short": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "python",
        "platform",
        "uv",
        "rustc",
        "cargo",
        "just",
        "java"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "environment"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "exit_code",
          "started_at",
          "ended_at",
          "duration_ms",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "missing_evidence"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "started_at": {
            "anyOf": [
              {
                "$ref": "#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "ended_at": {
            "anyOf": [
              {
                "$ref": "#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "evidence": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "release_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/release_check"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_count",
        "present_count",
        "missing_count",
        "missing",
        "all_present",
        "semantic_checks_pass",
        "validation_gates_pass",
        "complete"
      ],
      "properties": {
        "artifact_count": {
          "type": "integer",
          "minimum": 0
        },
        "present_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "all_present": {
          "type": "boolean"
        },
        "semantic_checks_pass": {
          "type": "boolean"
        },
        "validation_gates_pass": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "status",
        "sha256",
        "size_bytes",
        "modified_at",
        "json"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "present",
            "missing"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "modified_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "json": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "release_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "reason",
        "details"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
